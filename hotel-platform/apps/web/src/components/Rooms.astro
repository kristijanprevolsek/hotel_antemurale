---
import type { Lang } from '@hp/core';
import { t } from '@hp/core';
import { site } from '../site';
import { useUI } from '../i18n';
import Icon from './Icon.astro';
import Landscape from './Landscape.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = useUI(lang);
---
<section id="rooms" class="section">
  <div class="wrap">
    <header class="head" data-reveal>
      <div>
        <span class="eyebrow">{site.name}</span>
        <h2>{ui.rooms}</h2>
      </div>
      <p class="intro">{ui.roomsIntro}</p>
    </header>

    <div class="grid">
      {site.rooms.map((room) => (
        <article class="card" data-reveal>
          <div class="media">
            {room.images[0]
              ? <img src={room.images[0]} alt={t(room.name, lang)} loading="lazy" decoding="async" width="800" height="600" />
              : <Landscape uid={`room-${room.id}`} />}
            {room.priceFrom && <span class="price">{ui.from(room.priceFrom)}</span>}
          </div>
          <div class="body">
            <h3>{t(room.name, lang)}</h3>
            <p>{t(room.description, lang)}</p>
            <ul class="chips">
              <li><Icon name="guests" />{ui.upTo(room.maxGuests)}</li>
              {room.sizeM2 && <li>{room.sizeM2} m²</li>}
              {room.features.map((f) => <li>{t(f, lang)}</li>)}
            </ul>
            <a class="ask" href="#contact" data-room={t(room.name, lang)}>
              {ui.askRoom}<Icon name="arrow-right" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Upit za sobu: unaprijed odabere sobu u obrascu
  document.querySelectorAll<HTMLAnchorElement>('a[data-room]').forEach((a) =>
    a.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#inquiry select[name="room"]');
      if (select) select.value = a.dataset.room ?? '';
    }),
  );
</script>

<style>
  .head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .head h2 { margin: 0; }
  .head .intro { margin: 0; justify-self: end; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1.5rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 250ms var(--ease), transform 250ms var(--ease);
  }
  .card:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
  .media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-primary-soft); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease); }
  .card:hover .media img { transform: scale(1.04); }
  .price {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--c-surface);
    color: var(--c-text);
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: var(--shadow);
  }
  .body { display: flex; flex-direction: column; flex: 1; padding: 1.5rem; }
  .body p { color: var(--c-muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0 0 1.5rem; }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--c-primary-soft);
    font-size: 0.875rem;
  }
  .chips :global(.icon) { width: 1rem; height: 1rem; color: var(--c-primary); }
  .ask {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
  }
  .ask :global(.icon) { transition: transform 200ms var(--ease); }
  .ask:hover :global(.icon) { transform: translateX(4px); }
  @media (max-width: 640px) { .head .intro { justify-self: start; } }
</style>
