---
import type { Lang, Room } from '@hp/core';
import { t } from '@hp/core';
import { site } from '../site';
import { useUI } from '../i18n';
import Icon from './Icon.astro';
import RoomCard from './RoomCard.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = useUI(lang);

// Integralni hotel: odjeljak po kući. Sobe bez kuće idu na kraj.
const houses = site.houses ?? [];
const known = new Set(houses.map((h) => h.id));
const roomsOf = (id: string) => site.rooms.filter((r) => r.houseId === id);
const unassigned: Room[] = site.rooms.filter((r) => !r.houseId || !known.has(r.houseId));
const grouped = houses.length > 0;
---
<section id="rooms" class="section">
  <div class="wrap">
    <header class="head" data-reveal>
      <div>
        <span class="eyebrow">{site.name}</span>
        <h2>{grouped ? ui.stay : ui.rooms}</h2>
      </div>
      <p class="intro">{ui.roomsIntro}</p>
    </header>

    {grouped ? (
      <>
        <nav class="jump" aria-label={ui.stay}>
          {houses.map((h, i) => (
            <a href={`#house-${h.id}`}><span class="n">{String(i + 1).padStart(2, '0')}</span>{t(h.name, lang)}</a>
          ))}
        </nav>
        {houses.map((h, i) => {
          const rooms = roomsOf(h.id);
          return (
            <section id={`house-${h.id}`} class="house" aria-labelledby={`house-${h.id}-title`}>
              <div class="house-head" data-reveal>
                <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 id={`house-${h.id}-title`}>{t(h.name, lang)}</h3>
                  {h.description && <p>{t(h.description, lang)}</p>}
                  {h.address && <p class="addr"><Icon name="map-pin" />{h.address}</p>}
                </div>
              </div>
              {rooms.length > 0 ? (
                <div class="grid">{rooms.map((room) => <RoomCard lang={lang} room={room} />)}</div>
              ) : (
                <a class="ask-house" href="#contact" data-room={t(h.name, lang)} data-reveal>
                  {ui.askHouse}<Icon name="arrow-right" />
                </a>
              )}
            </section>
          );
        })}
        {unassigned.length > 0 && (
          <section class="house" aria-labelledby="house-other-title">
            <div class="house-head" data-reveal>
              <span class="n" aria-hidden="true">·</span>
              <h3 id="house-other-title">{ui.otherRooms}</h3>
            </div>
            <div class="grid">{unassigned.map((room) => <RoomCard lang={lang} room={room} />)}</div>
          </section>
        )}
      </>
    ) : (
      <div class="grid">{site.rooms.map((room) => <RoomCard lang={lang} room={room} />)}</div>
    )}
  </div>
</section>

<script>
  // Upit za sobu ili kuću: unaprijed odabere stavku u obrascu
  document.querySelectorAll<HTMLAnchorElement>('a[data-room]').forEach((a) =>
    a.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#inquiry select[name="room"]');
      if (select) select.value = a.dataset.room ?? '';
    }),
  );
</script>

<style>
  .head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .head h2 { margin: 0; }
  .head .intro { margin: 0; justify-self: end; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.5rem;
  }
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: clamp(2rem, 5vw, 3rem); }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.4rem 1rem 0.4rem 0.5rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface);
    color: var(--c-text);
    text-decoration: none;
    font-weight: 500;
    transition: border-color 200ms, color 200ms;
  }
  .jump a:hover { border-color: var(--c-primary); color: var(--c-primary); }
  .jump .n {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--c-primary-soft);
    color: var(--c-primary);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .house + .house { margin-top: clamp(3rem, 7vw, 5rem); }
  .house-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: start;
    padding-top: 1.5rem;
    margin-bottom: 1.75rem;
    border-top: 1px solid var(--c-line);
  }
  .house-head > .n {
    font: 400 clamp(2.25rem, 5vw, 3.25rem)/1 var(--f-heading);
    color: var(--c-accent);
    min-width: 2ch;
  }
  .house-head h3 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.35em; }
  .house-head p { color: var(--c-muted); margin: 0 0 0.5rem; }
  .addr { display: flex; align-items: center; gap: 0.4rem; font-size: 0.95rem; }
  .ask-house {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
  }
  @media (max-width: 640px) { .head .intro { justify-self: start; } }
</style>
