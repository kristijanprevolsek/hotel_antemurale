---
import type { Lang } from '@hp/core';
import { site } from '../site';
import { useUI } from '../i18n';
import PhotoGrid from './PhotoGrid.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = useUI(lang);
---
{site.gallery?.length ? (
  <section id="gallery" class="section gallery" aria-labelledby="gallery-title">
    <div class="wrap">
      <h2 id="gallery-title" data-reveal>{ui.gallery}</h2>
      <PhotoGrid lang={lang} items={site.gallery} group="gallery" />
    </div>
  </section>
) : null}

<style>
  .gallery { padding-top: 0; }
  h2 { margin-bottom: 2rem; }
</style>
