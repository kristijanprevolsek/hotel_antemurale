---
import type { Lang } from '@hp/core';
import { t } from '@hp/core';
import { site } from '../site';
import { useUI } from '../i18n';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = useUI(lang);
const r = site.restaurant;
const tel = site.contact.phone.replace(/\s/g, '');
---
{r && (
  <section id="restaurant" class="section band">
    <div class="wrap grid">
      <div data-reveal>
        {r.openToPublic && <span class="badge"><Icon name="check" />{ui.openToPublic}</span>}
        <h2>{t(r.title, lang)}</h2>
        <p class="desc">{t(r.description, lang)}</p>
        {r.hours && <p class="hours"><Icon name="clock" />{t(r.hours, lang)}</p>}
        <a class="btn light" href={`tel:${tel}`}><Icon name="phone" />{ui.callRestaurant}</a>
      </div>
      <div class="media" data-reveal>
        {r.image
          ? <img src={r.image} alt={t(r.title, lang)} loading="lazy" decoding="async" />
          : <span class="mark" aria-hidden="true"><Icon name="restaurant" /></span>}
      </div>
    </div>
  </section>
)}

<style>
  .band {
    background: var(--c-primary);
    color: var(--c-on-primary);
    position: relative;
    overflow: hidden;
  }
  .grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    margin-bottom: 1.25rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--c-on-primary) 40%, transparent);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .badge :global(.icon) { width: 1rem; height: 1rem; }
  .desc { font-size: clamp(1.125rem, 1.8vw, 1.3rem); }
  .hours { display: flex; align-items: center; gap: 0.6rem; opacity: 0.9; }
  .btn.light { background: var(--c-on-primary); color: var(--c-primary); margin-top: 0.5rem; }
  .btn.light:hover { background: color-mix(in srgb, var(--c-on-primary) 90%, var(--c-primary)); }
  .media {
    aspect-ratio: 1;
    border-radius: 50% 50% var(--radius) var(--radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--c-on-primary) 10%, transparent);
    display: grid;
    place-items: center;
  }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .mark :global(.icon) { width: clamp(4rem, 12vw, 7rem); height: auto; opacity: 0.55; stroke-width: 1.25; }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .media { aspect-ratio: 16 / 10; border-radius: var(--radius); }
    .media:not(:has(img)) { display: none; }
  }
</style>
