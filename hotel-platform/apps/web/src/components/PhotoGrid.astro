---
import type { GalleryItem, Lang } from '@hp/core';
import { t } from '@hp/core';

// Mreža fotografija; klik otvara Lightbox unutar grupe `group`.
interface Props { lang: Lang; items: GalleryItem[]; group: string }
const { lang, items, group } = Astro.props;
---
<ul class="photos">
  {items.map((p) => (
    <li class:list={{ wide: p.wide }} data-reveal>
      <a href={p.src} data-lb={group} data-alt={t(p.alt, lang)}>
        <img src={p.src} alt={t(p.alt, lang)} loading="lazy" decoding="async" />
      </a>
    </li>
  ))}
</ul>

<style>
  .photos {
    display: grid;
    /* Fiksni broj stupaca da se široke slike uklope bez rupa (4 na desktopu, 2 na mobitelu) */
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(150px, 18vw, 240px);
    grid-auto-flow: dense;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .wide { grid-column: span 2; }
  a { display: block; height: 100%; border-radius: var(--radius-sm); overflow: hidden; cursor: zoom-in; }
  img { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease); }
  a:hover img { transform: scale(1.04); }
  @media (max-width: 700px) {
    .photos { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 150px; gap: 0.5rem; }
  }
</style>
