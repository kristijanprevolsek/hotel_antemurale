---
import type { Lang } from '@hp/core';
import { useUI } from '../i18n';
import Icon from './Icon.astro';

// Jedan preglednik za cijelu stranicu. Svaka poveznica s data-lb="grupa" otvara
// svoju sliku; strelice listaju unutar iste grupe.
interface Props { lang: Lang }
const ui = useUI(Astro.props.lang);
---
<dialog class="lb" aria-label={ui.gallery} data-lb-dialog>
  <figure>
    <img alt="" />
    <figcaption><span class="cap"></span><span class="count"></span></figcaption>
  </figure>
  <button class="close" type="button" aria-label={ui.close}><Icon name="close" /></button>
  <button class="nav prev" type="button" aria-label={ui.prev}><Icon name="arrow-right" /></button>
  <button class="nav next" type="button" aria-label={ui.next}><Icon name="arrow-right" /></button>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lb-dialog]')!;
  const img = dlg.querySelector('img')!;
  const cap = dlg.querySelector<HTMLElement>('.cap')!;
  const count = dlg.querySelector<HTMLElement>('.count')!;
  let items: HTMLAnchorElement[] = [];
  let i = 0;

  const show = () => {
    const a = items[i];
    img.src = a.href;
    img.alt = a.dataset.alt ?? '';
    cap.textContent = a.dataset.alt ?? '';
    count.textContent = items.length > 1 ? `${i + 1} / ${items.length}` : '';
    dlg.classList.toggle('single', items.length < 2);
  };
  const step = (d: number) => {
    i = (i + d + items.length) % items.length;
    show();
  };

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lb]');
    if (!a || !dlg.showModal) return;
    e.preventDefault();
    items = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lb="${a.dataset.lb}"]`)];
    i = Math.max(0, items.indexOf(a));
    show();
    dlg.showModal();
  });
  dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('.prev')!.addEventListener('click', () => step(-1));
  dlg.querySelector('.next')!.addEventListener('click', () => step(1));
  dlg.addEventListener('click', (e) => e.target === dlg && dlg.close());
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
  // Povlačenje prstom na mobitelu
  let x0: number | null = null;
  dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  dlg.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
    x0 = null;
  });
</script>

<style>
  .lb {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: rgb(8 14 12 / 0.92);
    color: #fff;
  }
  .lb[open] { display: grid; place-items: center; }
  .lb::backdrop { background: transparent; }
  figure { margin: 0; display: grid; gap: 0.75rem; justify-items: center; }
  img { max-width: min(1200px, 100%); max-height: calc(100dvh - 8rem); object-fit: contain; border-radius: 8px; }
  figcaption { display: flex; gap: 1rem; font-size: 0.95rem; opacity: 0.85; }
  .count { opacity: 0.7; }
  button {
    position: fixed;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    cursor: pointer;
    transition: background-color 150ms;
  }
  button:hover { background: rgb(255 255 255 / 0.26); }
  .close { top: 1rem; right: 1rem; }
  .nav { top: 50%; transform: translateY(-50%); }
  .prev { left: 1rem; }
  .prev :global(.icon) { transform: rotate(180deg); }
  .next { right: 1rem; }
  .single .nav { display: none; }
  @media (max-width: 640px) { .nav { top: auto; bottom: 1rem; transform: none; } }
</style>
