---
import type { Lang } from '@hp/core';
import { t } from '@hp/core';
import { site } from '../../site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Rooms from '../../components/Rooms.astro';
import Restaurant from '../../components/Restaurant.astro';
import Inquiry from '../../components/Inquiry.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return site.languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---
<BaseLayout
  lang={lang}
  title={`${site.name} | ${t(site.hero.title, lang)}`}
  description={t(site.hero.subtitle, lang)}
>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Rooms lang={lang} />
    <Restaurant lang={lang} />
    <Inquiry lang={lang} />
  </main>
  <Footer />
</BaseLayout>
